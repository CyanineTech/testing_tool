## Example environment file for feishu_agent
## Copy this to /etc/default/feishu_agent and fill values, then reload systemd

# Feishu application credentials (required)
FEISHU_APP_ID=your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here

# Recommended minimal online mode
FEISHU_ENABLE_LOCAL_DIAG=1
# FEISHU_ENABLE_REMOTE_COLLECT=1

# Copilot CLI: path to copilot binary and timeout (seconds)
# COPILOTCLI_COMMAND can be an absolute path to the copilot binary
COPILOTCLI_COMMAND=/home/robot/.vscode-server/data/User/globalStorage/github.copilot-chat/copilotCli/copilot
COPILOTCLI_TIMEOUT=600
COPILOTCLI_ADDITIONAL_MCP=@/etc/copilot/mcp-config.json

# Optional flags
FEISHU_ENABLE_PROVIDER_REVIEW=1

# Optional: controlled PTY trial for amr route only.
# Keep these commented by default. Enable only for small-traffic verification.
# COPILOTCLI_ENABLE_PTY_PROTOCOL=1
# COPILOTCLI_PTY_ROUTES=amr
# COPILOTCLI_PTY_STALL_SECONDS=20
# COPILOTCLI_PTY_PROTOCOL_CORRECTION=1
# COPILOTCLI_PTY_PROTOCOL_CORRECTION_DELAY=8

# Optional: write provider traces during PTY verification.
# FEISHU_PROVIDER_TRACE_FILE=/home/robot/amr-rcs-troubleshoot/logs/provider_trace.log
